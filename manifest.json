{
  "manifest_version": 3,
  "name": "GTM Container Auditor",
  "version": "1.1",
  "description": "Parses a page's GTM container and displays it in a DevTools panel.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "devtools_page": "devtools.html",
  "sandbox": {
    "pages": [
      "sandbox.html"
    ]
  }
}